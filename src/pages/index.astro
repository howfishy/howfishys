---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
<div id="scene">
    <svg id="grid" viewBox="0 0 320 180" xmlns="http://www.w3.org/2000/svg">
      <!-- border -->
      <rect x="0" y="0" width="320" height="180" 
            fill="none" stroke="#ff6b35" stroke-width="0.5"/>
      <!-- vertical lines every 16px -->
      <line x1="16" y1="0" x2="16" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="32" y1="0" x2="32" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="48" y1="0" x2="48" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="64" y1="0" x2="64" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="80" y1="0" x2="80" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="96" y1="0" x2="96" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="112" y1="0" x2="112" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="128" y1="0" x2="128" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="144" y1="0" x2="144" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="160" y1="0" x2="160" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="176" y1="0" x2="176" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="192" y1="0" x2="192" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="208" y1="0" x2="208" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="224" y1="0" x2="224" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="240" y1="0" x2="240" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="256" y1="0" x2="256" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="272" y1="0" x2="272" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="288" y1="0" x2="288" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="304" y1="0" x2="304" y2="180" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <!-- horizontal lines every 16px -->
      <line x1="0" y1="16" x2="320" y2="16" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="32" x2="320" y2="32" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="48" x2="320" y2="48" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="64" x2="320" y2="64" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="80" x2="320" y2="80" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="96" x2="320" y2="96" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="112" x2="320" y2="112" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="128" x2="320" y2="128" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="144" x2="320" y2="144" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="160" x2="320" y2="160" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <line x1="0" y1="176" x2="320" y2="176" stroke="#ffffff" stroke-width="0.3" opacity="0.2"/>
      <!-- centre crosshair -->
      <line x1="160" y1="0" x2="160" y2="180" stroke="#ff6b35" stroke-width="0.5" opacity="0.5"/>
      <line x1="0" y1="90" x2="320" y2="90" stroke="#ff6b35" stroke-width="0.5" opacity="0.5"/>
      <!-- corner labels -->
      <text x="2" y="8" fill="#ff6b35" font-size="6">0,0</text>
      <text x="290" y="8" fill="#ff6b35" font-size="6">320,0</text>
      <text x="2" y="178" fill="#ff6b35" font-size="6">0,180</text>
      <text x="278" y="178" fill="#ff6b35" font-size="6">320,180</text>
    </svg>
  </div>
</BaseLayout>

<style>
	#scene {
		width: 100vw;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	#grid {
		width: 1280px;
		height: 720px;
		image-rendering: pixelated}
</style>